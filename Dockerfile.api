FROM python:3.12-slim

# C19 : cette image contient l'API FastAPI pour la livraison.
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# libgomp1 est utile pour certaines bibliotheques IA comme XGBoost.
RUN apt-get update \
    && apt-get install --no-install-recommends -y libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# On installe toutes les bibliotheques Python declarees dans le projet.
RUN pip install --no-cache-dir -r requirements.txt

# Code serveur, code IA et modele embarques dans l'image API.
COPY api ./api
COPY src ./src
COPY models ./models
COPY data/final/commerces_paris_secours.json ./data/final/commerces_paris_secours.json
COPY tests/test_prediction.py ./tests/test_prediction.py

# C19 : pendant la construction Docker, on verifie que le modele peut predire.
RUN python -m unittest discover -s tests -p "test_prediction.py" -v

EXPOSE 8000

# Commande lancee par le conteneur API en production.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
