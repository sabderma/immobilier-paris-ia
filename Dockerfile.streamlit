FROM python:3.12-slim

# C19 : cette image contient l'interface Streamlit pour la livraison.
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
# On installe les dependances de l'interface et du client API.
RUN pip install --no-cache-dir -r requirements.txt

# Ce chemin permet a Streamlit d'importer les modules du projet.
ENV PYTHONPATH=/app:/app/streamlit

# Code frontend, code commun et fichier GeoJSON utilise par la carte.
COPY streamlit ./streamlit
COPY src ./src
COPY data/raw/arrondissements_paris.geojson ./data/raw/arrondissements_paris.geojson

WORKDIR /app/streamlit

EXPOSE 8501

# Commande lancee par le conteneur frontend en production.
CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501"]
