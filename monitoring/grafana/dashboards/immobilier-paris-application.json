    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Part des reponses serveur en erreur 5xx sur la periode affichee.",
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "noValue": "0 %",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(100 * sum(increase(api_http_requests_total{status_code=~\"5..\"}[$__range])) / clamp_min(sum(increase(api_http_requests_total[$__range])), 1)) or vector(0)",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Erreurs 5xx",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Temps de reponse au 95e percentile sur la periode affichee.",
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "max": 5,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
